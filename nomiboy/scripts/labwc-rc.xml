<?xml version="1.0"?>
<labwc_config>
  <libinput>
    <device category="touch">
      <mapToOutput>SPI-1</mapToOutput>
      <calibrationMatrix>0 -1 1 1 0 0</calibrationMatrix>
    </device>
  </libinput>
  <windowRules>
    <windowRule identifier="*">
      <action name="Maximize" direction="both"/>
    </windowRule>
  </windowRules>
</labwc_config>
